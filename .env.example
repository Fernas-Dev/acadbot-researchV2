# ==============================================================
# AcadBot Research — variáveis de ambiente (exemplo)
# Copie este ficheiro para ".env" e preencha os valores.
# NUNCA coloque valores reais no código. NUNCA commite o .env.
# ==============================================================

# --- Supabase (obrigatório para auth + base de dados) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Providers académicos ---
# Crossref funciona sem key; mailto ativa o "polite pool" (recomendado)
CROSSREF_MAILTO=
# Semantic Scholar funciona sem key (limites baixos); key melhora limites
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex funciona sem key; use o mailto (polite pool)
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# --- IA (OPCIONAL — compatível com API OpenAI) ---
# Sem key, o sistema usa análise determinística (sem IA) para
# pesquisa/validação. A IA é usada apenas para análise de literatura,
# preenchimento da matriz e refinamento do topic analyzer.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Frontend (lidas a partir de envDir = raiz; apenas VITE_*) ---
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Aplicação ---
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Limites de uso (plano gratuito) ---
FREE_RESEARCH_LIMIT=20
FREE_VALIDATION_LIMIT=100
FREE_BULK_MAX_REFERENCES=100
MAX_CONCURRENT_JOBS=2
